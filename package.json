{
  "name": "agresearch-labs-assignment",
  "version": "1.0.0",
  "description": "Aeroponic leafy greens batch tracking REST API for AgResearch Labs",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrator.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "keywords": [
    "fastify",
    "typescript",
    "postgresql",
    "aeroponics",
    "agtech"
  ],
  "author": "Ganesh",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "pg-mem": "^3.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
